{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "incremental": true,
    "module": "esnext",
    "esModuleInterop": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts",
    "**/*.ts",
    "**/*.tsx",
    "src/app/(admin)/categories/page.jsx",
    "src/app/(admin)/cms/banners/page.jsx",
    "src/app/(admin)/cms/page.jsx",
    "src/app/(admin)/customers/page.jsx",
    "src/app/(admin)/dashboard/page.jsx",
    "src/app/(admin)/inventory/page.jsx",
    "src/app/(admin)/orders/page.jsx",
    "src/app/(admin)/products/new/page.jsx",
    "src/app/(admin)/products/page.jsx"
, "src/app/(admin)/layout.jsx"  ],
  "exclude": [
    "node_modules"
  ]
}